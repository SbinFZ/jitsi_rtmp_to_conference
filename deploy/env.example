# Copy to .env next to compose.yaml. Never commit the real file.
# Mode: pull (service "stream") or ingest (service "ingest", RTMP push)
COMPOSE_PROFILES=pull

JITSI_HOST=m.yuanjinapp.com
JITSI_ROOM=my-live-room
MEETING_RETRIES=5

# --- service "stream" (pull) ---
STREAM_NAME=Live Stream
STREAM_INPUT=https://example.com/app/live.flv
# NodeMedia PLAY signing key (not the panel password); re-signs every reconnect
NODEMEDIA_AUTH_KEY=
# HTTP-FLV only: empty = auto (env/system proxy), "direct", or http://host:port
INPUT_PROXY=

# --- service "ingest" (RTMP push; set COMPOSE_PROFILES=ingest) ---
INGEST_NAME=RTMP Live
RTMP_PORT=1935
# Use a long random value; it is the push password. e.g. openssl rand -hex 16
RTMP_KEY=

# Use a locally built image instead of GHCR: docker build -t jitsi-stream:local .
# JITSI_STREAM_IMAGE=jitsi-stream:local
