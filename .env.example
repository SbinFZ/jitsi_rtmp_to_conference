# Copy to .env only if needed; never commit real credentials.
JITSI_HOST=m.yuanjinapp.com
JITSI_ROOM=my-live-room
STREAM_NAME=Live Stream
STREAM_INPUT=https://example.com/app/live.flv
# Optional: NodeMedia PLAY signing key (not the admin panel password)
NODEMEDIA_AUTH_KEY=
# HTTP-FLV input only; Linux host-network can use a local proxy here
INPUT_PROXY=
